def user_has_permission(user, permissions):
    """
    Ð¥ÑÑ€ÑÐ³Ð»ÑÐ³Ñ‡ ÑÑ€Ñ…Ñ‚ÑÐ¹ ÑÑÑÑ…Ð¸Ð¹Ð³ ÑˆÐ°Ð»Ð³Ð°Ñ…
    
    Ð‘Ð¾Ð»Ð¾Ð¼Ð¶Ð¸Ñ‚ ÑÑ€Ñ…Ò¯Ò¯Ð´:
    - 'authenticated': ÐÑÐ²Ñ‚ÑÑ€ÑÑÐ½ Ð±Ò¯Ñ… Ñ…ÑÑ€ÑÐ³Ð»ÑÐ³Ñ‡
    - 'is_admin': ÐÐ´Ð¼Ð¸Ð½ ÑÑ€Ñ…
    - 'is_accountant': ÐÑÐ³Ñ‚Ð»Ð°Ð½ Ð±Ð¾Ð´Ð¾Ð³Ñ‡
    - 'is_teacher': Ð‘Ð°Ð³Ñˆ
    - 'is_staff': Staff ÑÑ‚Ð°Ñ‚ÑƒÑÑ‚Ð°Ð¹
    - 'is_superuser': Superuser
    - 'role:MANAGER': Ð¢Ð¾Ð´Ð¾Ñ€Ñ…Ð¾Ð¹ Ñ€Ð¾Ð»ÑŒ
    - 'group:ÐÐ³ÑƒÑƒÐ»Ð°Ñ…Ñ‹Ð½ Ð¼ÐµÐ½ÐµÐ¶ÐµÑ€': Ð¢Ð¾Ð´Ð¾Ñ€Ñ…Ð¾Ð¹ Ð±Ò¯Ð»ÑÐ³
    - 'perm:main.add_product': Django permission
    """
    if not user.is_authenticated:
        return False
    
    # ÐÑÐ³ Ñ‡ ÑÑ€Ñ… Ð·Ð°Ð°Ð°Ð³Ò¯Ð¹ Ð±Ð¾Ð» Ð±Ò¯Ñ… Ð½ÑÐ²Ñ‚ÑÑ€ÑÑÐ½ Ñ…ÑÑ€ÑÐ³Ð»ÑÐ³Ñ‡Ð¸Ð´ Ñ…Ð°Ñ€Ð°Ð³Ð´Ð°Ð½Ð°
    if not permissions:
        return True
    
    for permission in permissions:
        # Authenticated
        if permission == 'authenticated' and user.is_authenticated:
            return True
        
        # Superuser Ð±Ð¾Ð» Ð±Ò¯Ð³Ð´Ð¸Ð¹Ð³ Ñ…Ð°Ñ€Ð½Ð°
        if user.is_superuser:
            return True
        
        # Profile-based ÑÑ€Ñ…Ò¯Ò¯Ð´
        if hasattr(user, 'profile'):
            profile = user.profile
            
            if permission == 'is_admin' and profile.is_admin:
                return True
            if permission == 'is_accountant' and profile.is_accountant:
                return True
            if permission == 'is_teacher' and profile.is_teacher:
                return True
            
            # Role ÑˆÐ°Ð»Ð³Ð°Ñ…
            if permission.startswith('role:'):
                role_name = permission.split(':')[1]
                if profile.role == role_name:
                    return True
        
        # User-based ÑÑ€Ñ…Ò¯Ò¯Ð´
        if permission == 'is_staff' and user.is_staff:
            return True
        if permission == 'is_superuser' and user.is_superuser:
            return True
        
        # Group ÑˆÐ°Ð»Ð³Ð°Ñ…
        if permission.startswith('group:'):
            group_name = permission.split(':')[1]
            if user.groups.filter(name=group_name).exists():
                return True
        
        # Django permission ÑˆÐ°Ð»Ð³Ð°Ñ…
        if permission.startswith('perm:'):
            perm_name = permission.split(':')[1]
            if user.has_perm(perm_name):
                return True
    
    return False


def get_user_menu(user):
    """Ð¥ÑÑ€ÑÐ³Ð»ÑÐ³Ñ‡Ð¸Ð¹Ð½ ÑÑ€Ñ…ÑÑÑ€ Ð½ÑŒ Ñ†ÑÑ Ð±ÑƒÑ†Ð°Ð°Ñ…"""
    filtered_menu = []
    
    for section in SIDEBAR_MENU:
        # Section ÑÑ€Ñ… ÑˆÐ°Ð»Ð³Ð°Ñ…
        if not user_has_permission(user, section.get('permissions', [])):
            continue
        
        # Items ÑˆÒ¯Ò¯Ñ…
        filtered_items = []
        for item in section.get('items', []):
            if user_has_permission(user, item.get('permissions', [])):
                filtered_items.append(item)
        
        # Ð¥Ð¾Ð¾ÑÐ¾Ð½ section Ñ…Ð°Ñ€ÑƒÑƒÐ»Ð°Ñ…Ð³Ò¯Ð¹
        if filtered_items:
            section_copy = section.copy()
            section_copy['items'] = filtered_items
            filtered_menu.append(section_copy)
    
    return filtered_menu

